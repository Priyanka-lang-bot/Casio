# Copy this file to .env and change the values.
# Database connection (PostgreSQL)
DATABASE_URL=postgresql+psycopg://casio:casio_dev_password@localhost:5432/casio
# Set to true when the site is served over HTTPS (production)
COOKIE_SECURE=false
# Where links in password reset emails should point
FRONTEND_URL=http://localhost:3000
# "console" prints password reset emails to the backend terminal (no email server needed)
EMAIL_MODE=console
# Optional: AI categorisation of imported transactions. Get a key at
# https://console.anthropic.com. Leave empty to use built-in keyword rules only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
